{
    "name": "facturacheck/verifactu-saas",
    "description": "FacturaCheck - SaaS multitenencia para facturación electrónica con Verifactu",
    "keywords": ["yii2", "framework", "advanced", "project template", "verifactu", "invoicing", "saas", "multitenant"],
    "homepage": "https://facturacheck.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "yiisoft/yii2": "~2.0.49",
        "yiisoft/yii2-bootstrap5": "~2.0.4",
        "yiisoft/yii2-symfonymailer": "~3.0.0",
        "yiisoft/yii2-redis": "~2.0.0",
        "yiisoft/yii2-queue": "~2.3.0",
        "firebase/php-jwt": "^6.10",
        "endroid/qr-code": "^5.0",
        "phpoffice/phpspreadsheet": "^2.0",
        "tecnickcom/tcpdf": "^6.7",
        "phpseclib/phpseclib": "^3.0",
        "ramsey/uuid": "^4.7",
        "nesbot/carbon": "^3.0",
        "predis/predis": "^2.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-intl": "*"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "codeception/codeception": "^5.1.0",
        "codeception/lib-innerbrowser": "^4.0",
        "codeception/module-asserts": "^3.0",
        "codeception/module-yii2": "^1.1",
        "codeception/module-filesystem": "^3.0",
        "codeception/verify": "^3.2",
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^7.0",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "php-http/discovery": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "common\\": "common/",
            "api\\": "api/",
            "backend\\": "backend/",
            "superbackend\\": "superbackend/",
            "frontend\\": "frontend/",
            "console\\": "console/",
            "website\\": "website/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "common/config/main-local.php",
                "backend/config/main-local.php",
                "superbackend/config/main-local.php",
                "frontend/config/main-local.php"
            ]
        }
    }
}
