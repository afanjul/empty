# Facturacheck - Configuración de Entorno
# Copie este archivo a .env y ajuste los valores según su entorno

# ==============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==============================================
DB_ROOT_PASSWORD=rootpassword_change_me
DB_NAME=facturacheck
DB_USER=facturacheck
DB_PASSWORD=facturacheck_change_me
DB_HOST=mysql
DB_PORT=3306

# ==============================================
# CONFIGURACIÓN DE REDIS
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# ==============================================
# CONFIGURACIÓN DE APLICACIÓN
# ==============================================
# Modo debug (true para desarrollo, false para producción)
YII_DEBUG=true
YII_ENV=dev

# Cookie validation key (genere una clave aleatoria segura)
COOKIE_VALIDATION_KEY=generate_random_key_here

# ==============================================
# CONFIGURACIÓN DE SEGURIDAD
# ==============================================
# JWT Secret para autenticación API (genere una clave aleatoria segura)
JWT_SECRET=generate_random_jwt_secret_here
JWT_EXPIRE=3600

# ==============================================
# CONFIGURACIÓN DE VERIFACTU
# ==============================================
# Clave secreta para generación de hashes Verifactu
VERIFACTU_SECRET_KEY=your_verifactu_secret_key_change_me

# Algoritmo de hash (sha256 recomendado)
VERIFACTU_HASH_ALGORITHM=sha256

# URL base de AEAT para QR codes
VERIFACTU_AEAT_BASE_URL=https://www.aeat.es/verifactu

# ==============================================
# CONFIGURACIÓN DE CERTIFICADOS DIGITALES
# ==============================================
# Ruta al directorio de certificados (dentro del contenedor)
CERTIFICATES_PATH=/var/www/html/common/certificates

# ==============================================
# CONFIGURACIÓN DE EMAIL (opcional)
# ==============================================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@facturacheck.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@facturacheck.com
MAIL_FROM_NAME=Facturacheck

# ==============================================
# CONFIGURACIÓN DE APLICACIÓN WEB
# ==============================================
# URL base de la aplicación
APP_URL=http://localhost

# Puerto web (80 por defecto)
WEB_PORT=80

# Puerto phpMyAdmin (8080 por defecto)
PHPMYADMIN_PORT=8080

# ==============================================
# MULTI-TENANCY
# ==============================================
# Método de detección de tenant: subdomain, header, parameter
TENANT_DETECTION_METHOD=subdomain

# Header name si se usa detección por header
TENANT_HEADER_NAME=X-Tenant-ID

# Parameter name si se usa detección por parámetro
TENANT_PARAMETER_NAME=tenant
